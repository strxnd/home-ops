# Apply the public 4,000 x 4,000 block border at the origin in every playable dimension.
execute in minecraft:overworld run worldborder center 0 0
execute in minecraft:overworld run worldborder set 4000
execute in minecraft:the_nether run worldborder center 0 0
execute in minecraft:the_nether run worldborder set 4000
execute in minecraft:the_end run worldborder center 0 0
execute in minecraft:the_end run worldborder set 4000
